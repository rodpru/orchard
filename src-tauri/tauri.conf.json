{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchard",
  "version": "0.2.1",
  "identifier": "io.github.rodpru.orchard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orchard",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "rodpru",
    "homepage": "https://rodpru.github.io/orchard/",
    "category": "DeveloperTool",
    "shortDescription": "Run coding agents in parallel git worktrees",
    "longDescription": "Orchard gives every task its own git worktree, with a coding agent working in it, extra shells, lazygit alongside, and the PR and CI status of its branch.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "recommends": ["lazygit", "gh"]
      }
    }
  }
}
