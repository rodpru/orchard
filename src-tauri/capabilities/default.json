{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://localhost"
        },
        {
          "url": "http://localhost/*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1"
        },
        {
          "url": "http://127.0.0.1/*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://[[]::1[]]"
        },
        {
          "url": "http://[[]::1[]]/*"
        },
        {
          "url": "http://[[]::1[]]:*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:default"
  ]
}
